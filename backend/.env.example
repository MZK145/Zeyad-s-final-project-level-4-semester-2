PORT=5001
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/metroflow
# Replace this with a random secret of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Comma-separated browser origins allowed to call the API.
# Example: FRONTEND_ORIGINS=http://localhost:8000,https://example.com
FRONTEND_ORIGINS=
# Required for the rubric-compatible admin login. Run `npm run seed:admin` once.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
