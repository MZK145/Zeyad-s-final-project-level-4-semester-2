PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/metroflow
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated browser origins allowed to call the API.
# Example: FRONTEND_ORIGINS=http://localhost:8000,https://example.com
FRONTEND_ORIGINS=
# Optional administrator account. Leave both empty to disable password-based admin login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
