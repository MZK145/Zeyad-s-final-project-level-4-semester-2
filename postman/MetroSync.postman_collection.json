{
  "info": {
    "name": "MetroSync API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "change-me" },
    { "key": "userEmail", "value": "user@example.com" },
    { "key": "userPassword", "value": "change-me" },
    { "key": "token", "value": "" },
    { "key": "stationId", "value": "000000000000000000000000" }
  ],
  "item": [
    {
      "name": "Health - Public",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" },
      "response": [{ "name": "200 - health ok", "status": "OK", "code": 200, "_postman_previewlanguage": "json", "body": "{\n  \"status\": \"ok\"\n}" }]
    },
    {
      "name": "Login - Admin",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }, "url": "{{baseUrl}}/api/v1/auth/login" },
      "response": [{ "name": "200 - token returned", "status": "OK", "code": 200, "_postman_previewlanguage": "json", "body": "{\n  \"token\": \"<jwt>\",\n  \"role\": \"admin\"\n}" }]
    },
    {
      "name": "Stations - List",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/stations" },
      "response": [{ "name": "200 - station array", "status": "OK", "code": 200, "_postman_previewlanguage": "json", "body": "[\n  {\n    \"name\": \"Example Station\",\n    \"line\": \"Line 1\",\n    \"order\": 1\n  }\n]" }]
    },
    {
      "name": "Announcements - List",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/stations/{{stationId}}/announcements?page=1&limit=10" },
      "response": [{ "name": "200 - paginated announcements", "status": "OK", "code": 200, "_postman_previewlanguage": "json", "body": "{\n  \"items\": [],\n  \"page\": 1,\n  \"limit\": 10,\n  \"totalItems\": 0,\n  \"totalPages\": 0\n}" }]
    },
    {
      "name": "Announcements - Create",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"message\": \"Train arriving in 3 minutes.\"\n}" }, "url": "{{baseUrl}}/api/v1/stations/{{stationId}}/announcements" },
      "response": [{ "name": "201 - announcement created", "status": "Created", "code": 201, "_postman_previewlanguage": "json", "body": "{\n  \"stationId\": \"000000000000000000000000\",\n  \"message\": \"Train arriving in 3 minutes.\"\n}" }, { "name": "401 - missing token", "status": "Unauthorized", "code": 401, "_postman_previewlanguage": "json", "body": "{\n  \"error\": \"Authentication required\"\n}" }]
    },
    {
      "name": "Waiting Rooms - Admin List",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/users/waiting-rooms" },
      "response": [{ "name": "200 - room presence snapshot", "status": "OK", "code": 200, "_postman_previewlanguage": "json", "body": "{\n  \"totalRooms\": 1,\n  \"activeRooms\": 1,\n  \"onlinePassengers\": 1,\n  \"rooms\": [\n    {\n      \"stationId\": \"000000000000000000000000\",\n      \"name\": \"Example Station\",\n      \"onlinePassengers\": 1,\n      \"active\": true\n    }\n  ]\n}" }]
    },
    {
      "name": "Waiting Rooms - User Join",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"stationId\": \"{{stationId}}\"\n}" }, "url": "{{baseUrl}}/api/v1/users/waiting-rooms/join" },
      "response": [{ "name": "200 - joined room", "status": "OK", "code": 200, "_postman_previewlanguage": "json", "body": "{\n  \"ok\": true,\n  \"stationId\": \"000000000000000000000000\"\n}" }]
    },
    {
      "name": "Waiting Rooms - User Leave",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/users/waiting-rooms/leave" },
      "response": [{ "name": "200 - left room", "status": "OK", "code": 200, "_postman_previewlanguage": "json", "body": "{\n  \"ok\": true\n}" }]
    }
  ]
}
