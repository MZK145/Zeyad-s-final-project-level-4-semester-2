{
  "info": {
    "name": "MetroSync API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "change-me" },
    { "key": "token", "value": "" },
    { "key": "stationId", "value": "000000000000000000000000" }
  ],
  "item": [
    {
      "name": "Login - Admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      },
      "response": [
        {
          "name": "200 - token returned",
          "originalRequest": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"correct-password\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"token\": \"<jwt>\",\n  \"role\": \"admin\"\n}"
        }
      ]
    },
    {
      "name": "Stations - List",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/stations"
      },
      "response": [
        {
          "name": "200 - station array",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "[\n  {\n    \"name\": \"Example Station\",\n    \"line\": \"Line 1\",\n    \"order\": 1\n  }\n]"
        }
      ]
    },
    {
      "name": "Announcements - List",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/stations/{{stationId}}/announcements?page=1&limit=10"
      },
      "response": [
        {
          "name": "200 - paginated announcements",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"items\": [],\n  \"page\": 1,\n  \"limit\": 10,\n  \"totalItems\": 0,\n  \"totalPages\": 0\n}"
        }
      ]
    },
    {
      "name": "Announcements - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Train arriving in 3 minutes.\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/stations/{{stationId}}/announcements"
      },
      "response": [
        {
          "name": "201 - announcement created",
          "status": "Created",
          "code": 201,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"stationId\": \"000000000000000000000000\",\n  \"message\": \"Train arriving in 3 minutes.\",\n  \"createdAt\": \"2026-01-01T00:00:00.000Z\"\n}"
        },
        {
          "name": "401 - missing token",
          "status": "Unauthorized",
          "code": 401,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"error\": \"Authentication required\"\n}"
        }
      ]
    }
  ]
}
